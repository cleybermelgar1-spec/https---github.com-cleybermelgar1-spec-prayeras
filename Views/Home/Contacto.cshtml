@{
    ViewData["Title"] = "Contáctanos";
}

<style>
    .contact-container {
        max-width: 600px;
        margin: 50px auto;
        background: #14141f;
        padding: 35px;
        border-radius: 12px;
        border: 1px solid #ff007f;
        box-shadow: 0 0 20px rgba(255, 0, 127, 0.2);
    }
    .contact-title { text-align: center; color: #ff007f; font-size: 2rem; font-weight: 900; text-transform: uppercase; margin-bottom: 10px; }
    .contact-sub { text-align: center; color: #a0a0b8; margin-bottom: 25px; font-size: 0.9rem; }
    
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 700; color: #00f0ff; font-size: 0.85rem; text-transform: uppercase; }
    .form-control {
        width: 100%;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #2a2a40;
        background: #0d0d12;
        color: white;
        font-size: 0.95rem;
    }
    .form-control:focus { outline: none; border-color: #00f0ff; }
    
    .btn-submit {
        background: #ff007f;
        color: white;
        border: none;
        padding: 14px;
        border-radius: 6px;
        font-weight: 900;
        text-transform: uppercase;
        cursor: pointer;
        width: 100%;
        font-size: 1rem;
        letter-spacing: 1px;
        margin-top: 10px;
        transition: 0.3s;
    }
    .btn-submit:hover { background: #00f0ff; color: #000; }
    
    .alert-success {
        background: rgba(0, 240, 255, 0.15);
        border: 1px solid #00f0ff;
        color: #00f0ff;
        padding: 15px;
        border-radius: 6px;
        text-align: center;
        margin-bottom: 20px;
        font-weight: 700;
    }
</style>

<div class="contact-container">
    <h2 class="contact-title">📩 Contáctanos</h2>
    <p class="contact-sub">¿Tienes alguna duda o quieres cotizar un diseño personalizado? Déjanos un mensaje.</p>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert-success">
            @ViewBag.Mensaje
        </div>
    }

    <form asp-controller="Home" asp-action="Contacto" method="post">
        <div class="form-group">
            <label>Nombre Completo</label>
            <input type="text" name="nombre" class="form-control" placeholder="Ej. Juan Pérez" required />
        </div>

        <div class="form-group">
            <label>Correo Electrónico</label>
            <input type="email" name="email" class="form-control" placeholder="correo@ejemplo.com" required />
        </div>

        <div class="form-group">
            <label>Modelo / Tema de Interés</label>
            <select name="playera" class="form-control">
                <option value="Playera Personalizada Custom">Diseño Personalizado / Propio</option>
                <option value="Combo Duo Parejas">Combo Duo Parejas ($350.00)</option>
                <option value="Pack Familiar">Pack Familiar ($650.00)</option>
                <option value="Consulta General">Consulta General</option>
            </select>
        </div>

        <div class="form-group">
            <label>Talla (Opcional)</label>
            <select name="talla" class="form-control">
                <option value="Chica (CH)">Chica (CH)</option>
                <option value="Mediana (M)">Mediana (M)</option>
                <option value="Grande (G)">Grande (G)</option>
                <option value="Extra Grande (EG)">Extra Grande (EG)</option>
            </select>
        </div>

        <div class="form-group">
            <label>Mensaje / Detalle de la solicitud</label>
            <textarea name="detalles" class="form-control" rows="4" placeholder="Escribe tus dudas o describe cómo quieres tu playera..."></textarea>
        </div>

        <button type="submit" class="btn-submit">Enviar Mensaje</button>
    </form>
</div>